# Application
APP_NAME="Block CMS"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=UTC

# Public content API-first rollout
PUBLIC_CONTENT_V2_PREVIEW_ENABLED=true
PUBLIC_CONTENT_V2_ENABLED=false
PUBLIC_CONTENT_V2_SITE_IDS=
PUBLIC_CONTENT_V2_PAGE_TYPES=page,article,landing-page
PUBLIC_CONTENT_V2_SHADOW_ENABLED=false

# Database
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# Mail
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"
