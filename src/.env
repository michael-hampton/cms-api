# Application
APP_NAME="Block CMS"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:5001
APP_TIMEZONE=UTC
APP_LOCALE=en

# Database
DB_CONNECTION=mysql
DB_HOST_CLI=127.0.0.1
DB_HOST=db
DB_PORT=3306
DB_DATABASE=block_cms
DB_USERNAME=root
DB_PASSWORD="rootsecret"
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci
DB_PREFIX=""

# Database Logging
DB_LOG_QUERIES=true
DB_SLOW_QUERY_THRESHOLD=1000

# Mail
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD="your-app-password"
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@example.com
MAIL_FROM_NAME="${APP_NAME}"

# Logging
LOG_CHANNEL=single
LOG_LEVEL=debug
LOG_PATH=storage/logs

# Cache
CACHE_DRIVER=file
CACHE_TTL=3600

# Queue
QUEUE_CONNECTION=sync

# Session
SESSION_DRIVER=file
SESSION_LIFETIME=120

# Custom Variables
API_KEY=your-api-key-here
THIRD_PARTY_URL=https://api.example.com
MAX_UPLOAD_SIZE=10485760

# Boolean examples
FEATURE_ENABLED=true
MAINTENANCE_MODE=false

# Null example
OPTIONAL_SERVICE=null

# Numeric examples
RETRY_ATTEMPTS=3
TIMEOUT=30.5

# Multiline values (use quotes)
LONG_TEXT="This is a long text
that spans multiple lines
and contains special characters: !@#$%"

# Comments are supported
# This is a comment
DATABASE_URL=mysql://user:pass@host:port/db  # Inline comment

